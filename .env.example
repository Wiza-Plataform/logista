# Copiar para .env.local (nunca commitar o real — SEC-022)

# API da WIZA (repo `api`)
# Porta 3001 e não 3000: o `next dev` deste repo ocupa a 3000. Arrancar a API com PORT=3001.
API_BASE_URL=http://localhost:3001

# Sessão: o token da API fica no cookie HttpOnly `wiza_session`, escrito por este servidor — nunca no localStorage (SEC-003)
